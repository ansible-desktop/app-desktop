# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Ensure diffs have LF endings
*.diff text eol=lf
*.bat text eol=crlf

# Linux xdg integration files MUST be LF (parsed by Linux only)
lib/xdg/*.desktop      text eol=lf
lib/xdg/*.service      text eol=lf
lib/xdg/*.metainfo.xml text eol=lf

# Ensure lottie animations are treated as binary files
*.lottie binary
